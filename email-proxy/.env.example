# SendGrid API key — generate at https://app.sendgrid.com/settings/api_keys
# Requires permissions: Mail Send (full), Tracking (full)
SENDGRID_API_KEY=SG.your_api_key_here

# Verified sender email — must be authenticated in SendGrid
# Set up domain authentication: https://app.sendgrid.com/settings/sender_auth
DEFAULT_FROM_EMAIL=community@reputable.health
DEFAULT_FROM_NAME=Reputable Health

# SendGrid unsubscribe group ID (create at https://app.sendgrid.com/suppressions/advanced_suppression_manager)
SENDGRID_UNSUB_GROUP_ID=

# Server config
PORT=3001

# CORS — comma-separated origins allowed to call this proxy
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500,https://akamoore.github.io

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
